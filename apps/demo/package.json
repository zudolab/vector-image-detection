{
  "name": "@vector-image-detection/demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "zfb dev",
    "dev:worker": "node scripts/dev-worker.mjs",
    "typecheck": "pnpm run worker:types:check && tsc -b && zfb check && zfb wind audit --plan build --fail-on warning",
    "prebuild": "node scripts/clean-output.mjs",
    "build": "tsc -b && zfb build",
    "preview": "zfb preview",
    "render:production": "node scripts/render-production-config.mjs",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run --config wrangler.jsonc",
    "deploy:dry-run:production": "pnpm run build && wrangler deploy --dry-run --config wrangler.production.jsonc",
    "worker:types": "wrangler types ./src/worker/worker-configuration.d.ts --config wrangler.jsonc",
    "worker:types:check": "wrangler types ./src/worker/worker-configuration.d.ts --config wrangler.jsonc --check",
    "db:migrate:local": "wrangler d1 migrations apply vector-image-detection-demo-local --local --config wrangler.jsonc",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:dom": "vitest run --config vitest.dom.config.ts",
    "test:e2e": "pnpm run test:e2e:mocked && pnpm run test:e2e:worker",
    "test:e2e:mocked": "playwright test --pass-with-no-tests --config playwright.config.ts",
    "test:e2e:worker": "playwright test --pass-with-no-tests --config playwright.worker.config.ts",
    "test:output": "node --test tests/output.node-test.mjs",
    "seed": "node scripts/seed-runner.mjs",
    "seed:local": "pnpm run seed -- --target local",
    "test:seed": "node --test scripts/seed-manifest.node-test.mjs && vitest run --config vitest.worker.config.ts src/worker/features/photos/seed.integration.worker.test.ts"
  },
  "dependencies": {
    "@takazudo/zfb": "4.3.0",
    "@takazudo/zfb-runtime": "4.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "5.20260809.1",
    "@playwright/test": "1.62.1",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "^24.13.3",
    "sharp": "^0.35.3",
    "wrangler": "4.120.0",
    "happy-dom": "20.14.5",
    "@testing-library/dom": "10.4.2"
  }
}
